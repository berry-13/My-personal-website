{
    "name": "berry-13",
    "version": "0.6.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
        "dev:server": "bun --watch server/index.ts",
        "dev:client": "vite",
        "build": "bun run build:client && bun run build:server",
        "build:client": "vite build",
        "build:server": "bun build ./server/index.ts --outdir=./dist/server --target=bun",
        "start": "NODE_ENV=production bun dist/server/index.js",
        "preview": "vite preview",
        "lint": "eslint client/src --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "test": "NODE_ENV=development bun test client/src",
        "test:run": "NODE_ENV=development bun test client/src",
        "test:coverage": "NODE_ENV=development bun test client/src --coverage",
        "og": "bun scripts/generate-og.ts"
    },
    "dependencies": {
        "@elysiajs/cors": "^1.4.0",
        "@elysiajs/static": "^1.4.7",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@specy/liquid-glass-react": "^1.0.2",
        "@tsparticles/react": "^3.0.0",
        "@tsparticles/slim": "^3.9.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "elysia": "^1.4.19",
        "framer-motion": "^12.0.5",
        "katex": "^0.16.21",
        "lenis": "^1.1.20",
        "nprogress": "^0.2.0",
        "ogl": "^1.0.11",
        "react": "^19",
        "react-dom": "^19",
        "react-icons": "^5.4.0",
        "react-intersection-observer": "^10.0.0",
        "react-router-dom": "^7.11.0",
        "swr": "^2.2.0",
        "tailwind-merge": "^3.4.0"
    },
    "devDependencies": {
        "@happy-dom/global-registrator": "^20.0.11",
        "@resvg/resvg-js": "^2.6.2",
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/bun": "^1.3.13",
        "@types/katex": "^0.16.7",
        "@types/node": "^20.2.5",
        "@types/nprogress": "^0.2.0",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@typescript-eslint/eslint-plugin": "^8.50.0",
        "@typescript-eslint/parser": "^8.50.0",
        "@vitejs/plugin-react": "^5.1.2",
        "autoprefixer": "^10.4.5",
        "concurrently": "^9.2.1",
        "eslint": "^9.39.2",
        "postcss": "^8.4.12",
        "postcss-nesting": "^13.0.2",
        "satori": "^0.26.0",
        "tailwindcss": "^4.1.18",
        "typescript": "^5.9.3",
        "vite": "^7.3.0"
    }
}
