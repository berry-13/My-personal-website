# GitHub personal access token (read-only, public_repo scope is enough).
# Used by /api/repos to fetch repo metadata without hitting the 60 req/h
# unauthenticated rate limit.
GITHUB_TOKEN=

# Discord webhook URL for the contact form. The /api/send route POSTs the
# user-submitted email + message here as an embed.
WEBHOOK_URL=

# Comma-separated list of origins allowed by CORS. In production set this to
# your deployed domain (e.g. https://example.com). Leave empty to disable CORS.
ALLOWED_ORIGIN=

# Set to "true" only when running behind a trusted reverse proxy (nginx,
# Cloudflare, Render). Enables x-forwarded-for trust in the rate limiter so
# clients aren't all bucketed under one IP.
TRUSTED_PROXY=

# Optional: HTTP port for the Elysia server. Defaults to 3000.
PORT=

###################
# Awake / Home Assistant
###################
# Base URL of your Home Assistant instance, e.g. https://home.example.com
AWAKE_BASE_URL=
# Long-lived Home Assistant access token.
AWAKE_TOKEN=
# Entity ID for do-not-disturb, e.g. binary_sensor.<phone>_focus ("on" = DND).
# DND_ENTITY wins over the legacy DEVICE name.
DND_ENTITY=
DEVICE=
# Entity ID for the awake/asleep sensor. A binary_sensor whose id contains
# "sleep" means asleep when "on"; other binary sensors mean awake when "on";
# a text sensor means awake when "True". AWAKE_ENTITY wins over SENSOR_AWAKE.
AWAKE_ENTITY=
SENSOR_AWAKE=
